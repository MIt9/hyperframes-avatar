{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Avatar identity and visual design tokens",
  "type": "object", "additionalProperties": false,
  "required": ["version", "id", "status", "identity", "render", "palette", "proportions", "expressionSet", "poseSet", "avoid"],
  "properties": {
    "$schema": {"type":"string"},
    "version": {"const":1},
    "id": {"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},
    "status": {"enum":["concept","layered","validated"]},
    "identity": {
      "type":"object","additionalProperties":false,
      "required":["kind","presentation","silhouette","invariants"],
      "properties": {
        "kind":{"type":"string","minLength":1}, "presentation":{"type":"string","minLength":1},
        "hair":{"type":"string","minLength":1}, "outfit":{"type":"string","minLength":1},
        "features":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "silhouette":{"type":"string","minLength":1},
        "invariants":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
      }
    },
    "render": {
      "type":"object","additionalProperties":false,
      "required":["style","shading","outlinePx","referenceCanvas","background"],
      "properties": {
        "style":{"type":"string","minLength":1}, "shading":{"type":"string","minLength":1},
        "outlinePx":{"type":"number","minimum":0,"maximum":32},
        "referenceCanvas":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":64,"maximum":8192}},
        "background":{"$ref":"#/$defs/color"}
      }
    },
    "palette": {
      "type":"object","minProperties":3,
      "required":["ink"],
      "additionalProperties":{"$ref":"#/$defs/color"}
    },
    "proportions": {
      "type":"object","additionalProperties":false,
      "required":["headToVisibleHeight","eyeSeparationToHeadWidth","minimumSilhouettePadding"],
      "properties": {
        "headToVisibleHeight":{"type":"number","exclusiveMinimum":0,"maximum":0.8},
        "eyeSeparationToHeadWidth":{"type":"number","exclusiveMinimum":0,"maximum":1},
        "handToHeadWidth":{"type":"number","exclusiveMinimum":0,"maximum":1},
        "pawToHeadWidth":{"type":"number","exclusiveMinimum":0,"maximum":1},
        "minimumSilhouettePadding":{"type":"number","minimum":0.05,"maximum":0.3}
      }
    },
    "expressionSet":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "poseSet":{"type":"array","minItems":1,"uniqueItems":true,"contains":{"const":"idle"},"items":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"}},
    "avoid":{"type":"array","items":{"type":"string","minLength":1}}
  },
  "$defs":{"color":{"type":"string","pattern":"^#[0-9A-Fa-f]{6}$"}}
}
