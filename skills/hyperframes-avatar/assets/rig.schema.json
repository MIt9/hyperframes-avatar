{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Avatar art preparation and supported body motion",
  "type":"object","additionalProperties":false,
  "required":["version","characterId","status","coordinateSystem","origin","layerOrder","anchors","plannedChannels","motionProfile","limits","notes"],
  "properties":{
    "$schema":{"type":"string"}, "version":{"const":1},
    "characterId":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},
    "status":{"enum":["planning","layered","validated"]},
    "coordinateSystem":{"const":"normalized-canvas"}, "origin":{"const":"top-left"},
    "layerOrder":{"type":"array","uniqueItems":true,"minItems":1,"items":{"type":"string","minLength":1}},
    "anchors":{"type":"object","minProperties":1,"additionalProperties":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number","minimum":0,"maximum":1}}},
    "plannedChannels":{"type":"object","additionalProperties":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}}},
    "motionProfile":{
      "type":"object","additionalProperties":false,
      "required":["breathAmplitude","breathPeriod","swayDegrees","swayPeriod","gestureLeanDegrees","poseTransition"],
      "properties":{
        "breathAmplitude":{"type":"number","minimum":0,"maximum":0.025},
        "breathPeriod":{"type":"number","minimum":1,"maximum":10},
        "swayDegrees":{"type":"number","minimum":0,"maximum":3},
        "swayPeriod":{"type":"number","minimum":1,"maximum":12},
        "gestureLeanDegrees":{"type":"number","minimum":0,"maximum":5},
        "poseTransition":{"type":"number","minimum":0,"maximum":0.3}
      }
    },
    "limits":{
      "type":"object","additionalProperties":false,
      "required":["maximumGestureRate","minimumPoseHold","maximumBodyRotationDeg"],
      "properties":{
        "maximumGestureRate":{"type":"number","exclusiveMinimum":0,"maximum":2},
        "minimumPoseHold":{"type":"number","minimum":0.5,"maximum":10},
        "maximumBodyRotationDeg":{"type":"number","minimum":0,"maximum":8}
      }
    },
    "notes":{"type":"string","minLength":1}
  }
}
